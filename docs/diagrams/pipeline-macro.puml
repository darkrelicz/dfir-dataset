@startuml
!pragma layout smetana

skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

actor Maintainer

package "DFIR Dataset Repository" {
  [**CLI**\nscripts/] as CLI
  [**Policy**\nconfigs/ + taxonomy/] as Control
  [**Pipeline**\ncollect · synthesize · validate ·\nfilter · package · train · evaluate] as Services
  database "**Artifacts**\ndata/" as Artifacts
  [**Docs & state**\ndocs/ + project_state/] as Knowledge
}

cloud "**External resources**\nData sources · LLM APIs · local runtimes" as External

Maintainer --> CLI
Maintainer --> Control
Maintainer --> Knowledge
CLI --> Services
Control --> Services
Services <--> Artifacts
Services <--> External

@enduml
