@startuml
!pragma layout smetana
title Core Data Contracts

skinparam classAttributeIconSize 0
skinparam shadowing false

class RawDocument {
  doc_id: str
  source: str
  source_url: str
  title: str
  date_collected: date
  date_published: datetime | None
  content_type: str
  content_markdown: str
  metadata: dict[str, Any]
  word_count: int
}

class CollectionManifest {
  collector: str
  version: str
  source_url: str
  collected_at: datetime
  document_count: int
  errors: list[str]
  warnings: list[str]
  duration_seconds: float
}

class PromptRecord {
  prompt_id: str
  source_doc_id: str
  source: str
  source_type: str
  content_type: str
  category: str
  difficulty: Difficulty
  pairs_requested: int
  taxonomy_refs: list[str]
  prompt: str
}

class InstructionPair {
  instruction: str
  response: str
  category: str
  difficulty: Difficulty
  confidence: Confidence
  mitre_techniques: list[str]
  atlas_techniques: list[str]
  tools_referenced: list[str]
  source_doc_id: str
  source: str
  taxonomy_refs: list[str]
  grounding: Grounding
}

class QualityDecision {
  status: filtered | review | rejected
  issues: list[QualityIssue]
  score: QualityScore | None
}

class PackagedRecord {
  id: str
  messages: system/user/assistant[]
  metadata: dict
}

RawDocument "1" --> "many" PromptRecord : selected into
PromptRecord "1" --> "1..n" InstructionPair : asks teacher for
InstructionPair "1" --> "1" QualityDecision : Phase 4 decides
InstructionPair "1" --> "1" PackagedRecord : package-eligible rows become
CollectionManifest .. RawDocument : summarizes collection

@enduml
