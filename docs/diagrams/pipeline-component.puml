@startuml
!pragma layout smetana
title Shepherd DFIR Dataset Factory - Component View

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

actor "Maintainer" as Maintainer

package "Configuration" {
  [collection.yaml] as CollectionConfig
  [source_profiles.yaml] as SourceProfiles
  [task_categories.yaml] as TaskConfig
  [synthesis.yaml] as SynthesisConfig
  [quality.yaml] as QualityConfig
  [packaging.yaml] as PackagingConfig
  [evaluation.yaml] as EvaluationConfig
  [finetune_glm47flash.yaml] as FinetuneConfig
}

package "Phase 2 Collection" {
  [scripts.collect_all] as CollectCLI
  [BaseCollector] as BaseCollector
  [16 source collectors] as Collectors
  [RawDocument JSONL] as RawJsonl
  [collection_manifest.json] as CollectionManifest
}

package "Phase 3 Synthesis" {
  [scripts.synthesize] as SynthesizeCLI
  [planner.py] as Planner
  [PromptBuilder] as PromptBuilder
  [prompt templates] as PromptTemplates
  [prompt compactors] as Compactors
  [GeminiClient] as Gemini
  [Phase 3 validators] as SynthValidators
  [accepted/rejected/raw outputs] as SynthOutputs
}

package "Shared Validation" {
  [reasoning.py] as Reasoning
  [grounding.py] as Grounding
  [indicators.py] as Indicators
  [mappings.py] as Mappings
  [taxonomy.py] as Taxonomy
}

package "Phase 4 Quality" {
  [scripts.quality_filter] as QualityCLI
  [quality.runner] as QualityRunner
  [quality.validators] as QualityValidators
  [quality.dataset] as DatasetGates
  [quality.references] as References
  [filtered/review/rejected outputs] as QualityOutputs
}

package "Phase 5 Packaging" {
  [scripts.package_dataset] as PackageCLI
  [dataset_packaging.runner] as Packager
  [train/validation/test JSONL] as PackagedSplits
  [packaging_manifest.json] as PackagingManifest
}

package "Phase 6 Training" {
  [scripts.finetune] as TrainCLI
  [Unsloth LoRA SFT] as Trainer
  [checkpoints + adapter + GGUF] as ModelArtifacts
  [training_manifest.json] as TrainingManifest
}

package "Phase 6 Evaluation" {
  [scripts.run_evaluation] as EvaluateCLI
  [evaluation.runner] as EvaluationRunner
  [target client] as TargetClient
  [local LLM judge] as Judge
  [predictions + judge scorecard] as EvaluationOutputs
  [evaluation_manifest.json] as EvaluationManifest
  [scripts.compare_evaluations] as CompareCLI
  [comparison report] as ComparisonReport
}

Maintainer --> CollectCLI
Maintainer --> SynthesizeCLI
Maintainer --> QualityCLI
Maintainer --> PackageCLI
Maintainer --> TrainCLI
Maintainer --> EvaluateCLI
Maintainer --> CompareCLI

CollectionConfig --> CollectCLI
CollectCLI --> Collectors
Collectors -up-|> BaseCollector
Collectors --> RawJsonl
Collectors --> CollectionManifest

SourceProfiles --> Planner
TaskConfig --> Planner
SynthesisConfig --> Planner
SynthesisConfig --> Gemini
SynthesizeCLI --> Planner
Planner --> PromptBuilder
PromptBuilder --> PromptTemplates
PromptBuilder --> Compactors
PromptBuilder --> Gemini
Gemini --> SynthValidators
SynthValidators --> SynthOutputs
SynthValidators --> Reasoning
SynthValidators --> Grounding
SynthValidators --> Indicators
SynthValidators --> Mappings
SynthValidators --> Taxonomy
RawJsonl --> Planner

QualityConfig --> QualityRunner
TaskConfig --> QualityRunner
QualityCLI --> QualityRunner
SynthOutputs --> QualityRunner
RawJsonl --> QualityRunner
QualityRunner --> References
QualityRunner --> QualityValidators
QualityValidators --> Reasoning
QualityValidators --> Grounding
QualityValidators --> Indicators
QualityValidators --> Mappings
QualityValidators --> Taxonomy
QualityRunner --> DatasetGates
DatasetGates --> QualityOutputs

PackagingConfig --> Packager
PackageCLI --> Packager
QualityOutputs --> Packager
Packager --> PackagedSplits
Packager --> PackagingManifest

FinetuneConfig --> Trainer
TrainCLI --> Trainer
PackagedSplits --> Trainer
PackagingManifest --> Trainer
Trainer --> ModelArtifacts
Trainer --> TrainingManifest

EvaluationConfig --> EvaluationRunner
EvaluateCLI --> EvaluationRunner
EvaluationRunner --> TargetClient
EvaluationRunner --> Judge: after target response
EvaluationRunner --> EvaluationOutputs
EvaluationRunner --> EvaluationManifest: atomic checkpoint after verdict
EvaluationOutputs --> CompareCLI
CompareCLI --> ComparisonReport

@enduml
