@startuml
title Phase 3 Synthesis Sequence

skinparam shadowing false
autonumber

participant "scripts.synthesize" as CLI
participant "validate_raw_corpus" as RawValidator
participant "build_prompt_plan" as Planner
participant "PromptBuilder" as Builder
participant "compact_document_for_prompt" as Compactor
participant "GeminiClient" as Gemini
participant "validate_generated_pairs" as Validator
database "data/synthesized/<run>" as Out

CLI -> RawValidator: validate raw_dir
RawValidator --> CLI: RawCorpusValidation
CLI -> Planner: select docs by mode
Planner -> Planner: sample pilot/subset or sort full corpus
Planner -> Planner: assign category targets
Planner -> Planner: assign difficulty buckets
Planner -> Builder: build PromptRecord per doc
Builder -> Compactor: create prompt-ready source view
Builder --> Planner: PromptRecord
CLI -> Out: write prompts.jsonl

loop each non-skipped prompt
  CLI -> Gemini: generate(prompt)
  Gemini --> CLI: ModelResponse
  CLI -> Out: append raw_outputs.jsonl
  CLI -> Validator: parse and validate output
  alt valid
    Validator --> CLI: InstructionPair list
    CLI -> Out: append accepted.jsonl
  else invalid and retries remain
    CLI -> Gemini: regenerate with validator feedback
  else invalid
    CLI -> Out: append rejected.jsonl
  end
end

CLI -> Out: write generation_manifest.json

@enduml
