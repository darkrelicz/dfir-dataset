  "titleSuffix": "DFIR Dataset",
  "enableSearch": true,
  "headingIndexingLevel": 3,
  "timeZone": "Asia/Singapore",
  "style": {
    "darkMode": false,
    "codeTheme": "light",
    "codeLineNumbers": false
  },
  "pages": [
    {
      "src": "index.md",
      "title": "Guides Home"
    },
    {
      "src": "user/index.md",
      "title": "User Guides"
    },
    {
      "src": "current-state/index.md",
      "title": "Current Project State"
    },
    {
      "src": "current-state/revisions.md",
      "title": "Revisions"
    },
    {
      "src": "user/command-overview.md",
      "title": "Command Overview"
    },
    {
      "src": "user/source-overview.md",
      "title": "Source Overview"
    },
    {
      "src": "developer/index.md",
      "title": "Developer Guide"
    },
    {
      "src": "developer/collectors.md",
      "title": "Collectors"
    },
    {
      "src": "developer/synthesis.md",
      "title": "Synthesis"
    },
    {
      "src": "developer/quality-filtering.md",
      "title": "Quality Filtering"
    },
    {
      "src": "developer/packaging.md",
      "title": "Packaging"
    },
    {
      "src": "developer/finetuning.md",
      "title": "Fine-tuning"
    },
    {
      "src": "developer/evaluation.md",
      "title": "Evaluation"
    },
    {
      "src": "reference/taxonomy.md",
      "title": "DFIR Artifact Taxonomy"
    }
  ],
  "pagesExclude": [
    "node_modules/**/*.md",
    "_site/**/*.md"
  ],
  "ignore": [
    "_site/*",
    "node_modules/*",
    "package.json",
    "package-lock.json",
    "site.json",
    ".gitignore",
    "README.md",
    "_markbind/**/*"
  ],
  "intrasiteLinkValidation": {
    "enabled": true
  },
  "plantumlCheck": true
}
